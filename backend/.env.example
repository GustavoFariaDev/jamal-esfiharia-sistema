# Configurações do Sistema de Gestão Jamal Esfiharia

# Configurações do Flask
SECRET_KEY=sua-chave-secreta-aqui
DATABASE_URL=sqlite:///instance/esfiharia.db

# Configurações do Stripe (Pagamentos)
STRIPE_SECRET_KEY=sk_test_sua_chave_stripe_aqui
STRIPE_WEBHOOK_SECRET=whsec_sua_chave_webhook_aqui

# Configurações do Google Maps (Cálculo de Distância)
# Obtenha sua API Key em: https://console.cloud.google.com/apis/credentials
GOOGLE_MAPS_API_KEY=sua_api_key_do_google_maps_aqui

# Endereço do Restaurante (usado como ponto de origem para cálculo de distância)
# Formato: Rua, Número, Bairro, Cidade, Estado, País
ENDERECO_RESTAURANTE=Rua Exemplo, 100, Centro, São Paulo, SP, Brasil

