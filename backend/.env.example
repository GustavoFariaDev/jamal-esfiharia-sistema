# Copie para backend/.env e preencha. O .env NUNCA vai para o Git.
# No Render, os mesmos nomes vao em Environment > Environment Variables.

# --- Sessao ---
# Assina os tokens de login. Sem ela o sistema sorteia uma a cada
# inicializacao, e todo mundo e deslogado quando o servidor reinicia.
# Gere uma com: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# --- Banco ---
# Vazio = SQLite local em backend/instance/jamal.db.
# Em producao, a URL do PostgreSQL do Render.
DATABASE_URL=

# --- Primeiro administrador ---
# Libera POST /api/setup/create-admin, que sorteia a senha e mostra uma vez.
# Depois de criar o admin, pode remover.
SETUP_TOKEN=
ADMIN_EMAIL=admin@jamal.com

# --- Cloudinary (imagens dos produtos) ---
# Painel do Cloudinary > Dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Google Maps (opcional) ---
# Usado no calculo de distancia por endereco. O calculo por CEP, que o site
# usa, nao depende disto.
GOOGLE_MAPS_API_KEY=

# --- Servidor ---
# O Render define sozinho. Local, 5000.
PORT=5000
