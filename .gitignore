# ═══════════════════════════════════════════════════════════════════════
# .gitignore - Sistema Jamal Esfiharia
# ═══════════════════════════════════════════════════════════════════════

# Arquivos de credenciais e segurança (NUNCA COMMITAR!)
*.env
.env
.env.local
.env.production
.env.*.local
CREDENCIAIS_*.txt
*_CREDENCIAIS.txt
*.pem
*.key
*.crt

# Banco de dados
*.db
*.sqlite
*.sqlite3
instance/
backend/instance/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
venv/
env/
ENV/
.venv

# Logs
*.log
logs/
*.log.*
server.log

# Uploads e arquivos temporários
uploads/*
!uploads/.gitkeep
backend/uploads/*
!backend/uploads/.gitkeep
static/uploads/*
!static/uploads/.gitkeep
*.tmp
*.temp

# IDEs e editores
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Node.js (se houver frontend)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Build do frontend
frontend/build/
frontend/dist/
backend/static/

# Testes
.pytest_cache/
.coverage
htmlcov/
.tox/

# Backups
*.bak
*.backup
backup/
backups/

# Sistema operacional
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Desktop.ini

# ═══════════════════════════════════════════════════════════════════════
# IMPORTANTE: 
# - Revise este arquivo antes do primeiro commit
# - Garanta que nenhum arquivo sensível seja commitado
# - Use 'git status' para verificar arquivos não rastreados
# ═══════════════════════════════════════════════════════════════════════
